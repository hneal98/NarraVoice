<Window x:Class="NarraVoice.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NarraVoice.UI.Converters"
        xmlns:editor="clr-namespace:NarraVoice.Editor.Controls"
        Title="NarraVoice"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:ColorStringToBrushConverter x:Key="ColorToBrush"/>
    </Window.Resources>

    <!-- Menu -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveChunkCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RenderChunkCommand}"/>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PreviewCommand}"/>
        <KeyBinding Key="F5" Command="{Binding PreviewCommand}"/>
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding BatchRenderCommand}"/>
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PrevChunkCommand}"/>
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextChunkCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding OpenScratchpadCommand}"/>
        <KeyBinding Key="R" Modifiers="Alt" Command="{Binding ResumeCommand}"/>
        <KeyBinding Key="Z" Modifiers="Alt" Command="{Binding RestoreChunkCommand}"/>
        <KeyBinding Key="V" Modifiers="Alt" Command="{Binding VisualizeCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..."
                          Click="OnNewProject"/>
                <Separator/>
                <MenuItem Header="_Open Project">
                    <MenuItem Header="Open Story _File..."
                              Click="OnOpenStoryFile"/>
                    <MenuItem Header="_Resume from Folder..."
                              Click="OnResumeFromFolder"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Rename Project..."
                          x:Name="RenameProjectMenu"
                          IsEnabled="False"
                          Click="OnRenameProject"/>
                <MenuItem Header="_Delete Project..."
                          x:Name="DeleteProjectMenu"
                          IsEnabled="False"
                          Click="OnDeleteProject"/>
                <Separator/>
                <MenuItem Header="Open _Audio Folder"
                          x:Name="OpenAudioFolderMenu"
                          IsEnabled="False"
                          Click="OnOpenAudioFolder"/>
                <MenuItem Header="Open Audio_books Folder"
                          x:Name="OpenAudiobookFolderMenu"
                          IsEnabled="False"
                          Click="OnOpenAudiobookFolder"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Pronunciation _Substitutions..."
                          Click="OnOpenSubstitutions"/>
                <MenuItem Header="_Download Voices..."
                          Click="OnOpenVoiceManager"/>
                <Separator/>
                <MenuItem Header="_Scratchpad"
                          InputGestureText="Ctrl+Shift+S"
                          Click="OnOpenScratchpad"/>
                <MenuItem Header="_Substitutions..." Click="OnOpenSubstitutions"/>
                <MenuItem Header="_Voice Manager..." Click="OnOpenVoiceManager"/>
                <Separator/>
                <MenuItem Header="_Merge Audio Files..." Click="OnMergeSelectedFiles"/>
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- NEW: Story status label -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- New Project button + no-project hint -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="NewProjectBtn"
                        Content="✦ New Project — Start Here"
                        FontSize="15"
                        FontWeight="Bold"
                        Padding="16,8"
                        Click="OnNewProject"/>
                <TextBlock Grid.Column="1"
                           x:Name="NoProjectHint"
                           Text="— or open an existing project via File → Open Project"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="#888888"
                           FontStyle="Italic"
                           Visibility="Visible"/>
            </Grid>

            <!-- Story status label -->
            <TextBlock Grid.Row="1"
                       x:Name="StoryStatusLabel"
                       Text=""
                       HorizontalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"/>

            <!-- Chunk status label -->
            <TextBlock Grid.Row="2"
                       x:Name="ChunkStatusLabel"
                       Text=""
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <!-- Main editor + voice panel -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Editor column -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- Editor label -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Current Chunk Editor"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>

                    <!-- Silence tag button -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <Button x:Name="SilenceBtn"
                                Content="⏸ Silence"
                                Padding="8,3"
                                IsEnabled="True"
                                Click="OnInsertSilence"
                                ToolTip="Insert a silence tag at cursor position"/>

                    </StackPanel>

                    <!-- Gutter + Editor side by side -->
                    <editor:SmartTextEditor x:Name="ChunkEditor"
                        Background="#F8F8F8"
                        IsEnabled="True"
                        SmartIpaRequested="OnSmartIpaRequested"
                        DocumentModified="OnDocumentModified"/>
                </DockPanel>

                <!-- Voice and Presets panel -->
                <GroupBox Grid.Column="1"
                          Header="Voice and Presets"
                          IsEnabled="True"
                          x:Name="VoicePanel">
                    <StackPanel Margin="4" Background="#F8F8F8">

                        <!-- Voice -->
                        <TextBlock Text="Voice:" Margin="0,0,0,2"/>
                        <ComboBox x:Name="VoiceCombo"
                                  Margin="0,0,0,8"
                                  SelectionChanged="OnVoiceChanged"/>
                        <Button x:Name="InstructButton"
                                Content="Instruct..."
                                Margin="0,0,0,8"
                                Visibility="Collapsed"
                                Click="OnInstructClick"/>
                        <!-- Rate -->
                        <TextBlock Text="Rate:" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    x:Name="RateSlider"
                                    Minimum="-30" Maximum="30"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OnRateChanged"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="RateLabel"
                                       Text="+0%"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Pitch -->
                        <TextBlock Text="Pitch:" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    x:Name="PitchSlider"
                                    Minimum="-6" Maximum="6"
                                    TickFrequency=".25"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OnPitchChanged"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="PitchLabel"
                                       Text="+0st"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Volume -->
                        <TextBlock Text="Volume:" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                x:Name="VolumeSlider"
                                Minimum="50" Maximum="150"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnVolumeChanged"/>
                            <TextBlock Grid.Column="1"
                                   x:Name="VolumeLabel"
                                   Text="100%"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Neutral + Voice Blend buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                Content="⚗ Blend"
                                Click="OnVoiceBlend"
                                ToolTip="Create a blended voice from multiple voices"/>
                            <Button Grid.Column="2"
                                Content="Neutral"
                                Click="OnNeutral"
                                ToolTip="Reset rate and pitch to zero"/>
                        </Grid>

                        <!-- Preset -->
                        <TextBlock Text="Preset:" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PresetCombo"
                                  Margin="0,0,0,8"
                                  SelectionChanged="OnPresetChanged"/>

                        <!-- Preset buttons -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="10*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="▼ Save"
                                    Margin="0,0,4,0"
                                    Click="OnSavePreset"
                                    ToolTip="Save current voice settings as a preset" Grid.ColumnSpan="2"/>
                            <Button Grid.Column="2"
                                    Content="✕ Delete"
                                    Foreground="Red"
                                    Click="OnDeletePreset"
                                    ToolTip="Delete the selected preset"/>

                        </Grid>
                        <Button x:Name="PresetInstructButton"
                                    Content="Preset Instruct…"
                                    Margin="0,0,4,0"
                                    Padding="8,4"
                                    Visibility="Collapsed"
                                    Click="OnPresetInstructClick"
                                    ToolTip="Edit instruct for the selected preset (Qwen only)" Grid.ColumnSpan="2"/>
                    </StackPanel>
                </GroupBox>


                <!-- Scratchpad button -->
                <Button Grid.Column="1"
                    Content="🎤 Scratchpad"
                    VerticalAlignment="Bottom"
                    Margin="0,4,0,0"
                    Click="OnOpenScratchpad"
                    ToolTip="Open the voice tester (Ctrl+Shift+S)"/>

            </Grid>

            <!-- Chunk work buttons -->
            <WrapPanel Grid.Row="4"
                       Margin="0,8,0,0"
                       IsEnabled="False"
                       x:Name="ChunkButtonPanel">
                <Button Content="« Prev Chunk"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        Click="OnPrevChunk"
                        ToolTip="Go to previous chunk (Ctrl+Left)"/>
                <Button Content="» Next Chunk"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        Click="OnNextChunk"
                        ToolTip="Go to next chunk (Ctrl+Right)"/>
                <Button Content="↻ Resu_me"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        Click="OnResume"
                        ToolTip="Resume from next unrendered chunk (Alt+R)"/>
                <Button Content="⚙ _Render Chunk"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        x:Name="RenderBtn"
                        Click="OnRenderChunk"
                        ToolTip="Render this chunk to audio (Ctrl+R)"/>
                <Button Content="📁 _Batch Render"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        x:Name="BatchBtn"
                        Click="OnBatchRender"
                        ToolTip="Render all remaining chunks (Ctrl+B)"/>
                <Button Content="💾 _Save Chunk"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        Click="OnSaveChunk"
                        ToolTip="Save chunk to disk (Ctrl+S)"/>
                <Button Content="↶ Rest_ore Chunk"
                        Margin="0,0,4,4"
                        Padding="8,4"
                        Click="OnRestoreChunk"
                        ToolTip="Restore chunk from backup (Alt+Z)"/>
            </WrapPanel>

            <!-- Playback row -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        Margin="0,4,0,0"
                        IsEnabled="True"
                        x:Name="PlaybackPanel">
                <Button Content="🔍 _Preview"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        x:Name="PreviewBtn"
                        Click="OnPreview"
                        Background="#4169E1"
                        Foreground="Yellow"
                        FontWeight="Bold"
                        ToolTip="Preview selected text or full chunk (Ctrl+P or F5)"/>
                <Button Content="▶ Play"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        Click="OnPlay"/>
                <Button Content="⏸ Pause"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        x:Name="PauseResumeBtn"
                        Click="OnPauseResume"/>
                <Button Content="⏹ Stop"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        Click="OnStop"/>
                <Button Content="📊 _Visualize"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        Click="OnVisualize"
                        ToolTip="Visualize audio waveform (Alt+V)"/>
                <Button Content="✕ Cancel"
                        Margin="0,0,4,0"
                        Padding="8,4"
                        x:Name="CancelBtn"
                        IsEnabled="False"
                        Click="OnCancel"
                        Background="#2E86C1"
                        Foreground="LightGray" />
            </StackPanel>

            <!-- Activity log -->
            <Grid Grid.Row="6" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Activity Log"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Clear Log"
                        Padding="8,2"
                        Click="OnClearLog"/>
            </Grid>
            <TextBox Grid.Row="7"
                     x:Name="ActivityLog"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Height="120"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11"
                     Background="#F8F8F8"
                     Padding="4"/>

        </Grid>
    </DockPanel>
</Window>

<Window x:Class="NarraVoice.UI.Windows.ScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:NarraVoice.Editor.Controls"
        xmlns:converters="clr-namespace:NarraVoice.UI.Converters"
        Title="Scratchpad — Voice Tester"
        Width="580"
        Height="520"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="OnClosing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Instructions -->
        <TextBlock Grid.Row="0"
                   Text="Type any text below and click Preview to hear it. Right-click a word for Smart IPA. Nothing here is saved."
                   TextWrapping="Wrap"
                   Foreground="#555555"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Text editor -->
        <editor:SmartTextEditor Grid.Row="1"
         x:Name="TextEditor"
         Background="#F8F8F8"
         SmartIpaRequested="OnSmartIpaRequested"/>

        <!-- Voice controls -->
        <GroupBox Grid.Row="2"
                  Header="Voice Settings"
                  Margin="0,8,0,0"
                  Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <!-- Voice -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Voice:"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                          x:Name="VoiceCombo"
                          Margin="0,2"/>

                <!-- Rate -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Rate:"
                           VerticalAlignment="Center"
                           Margin="0,4,0,0"/>
                <Slider Grid.Row="1" Grid.Column="1"
                        x:Name="RateSlider"
                        Minimum="-30" Maximum="30"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Margin="0,4,8,0"
                        ValueChanged="OnRateChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           x:Name="RateLabel"
                           Text="+0%"
                           VerticalAlignment="Center"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Right"/>

                <!-- Pitch -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                        Text="Pitch:"
                        VerticalAlignment="Center"
                        Margin="0,4,0,0"/>
                <Slider Grid.Row="2" Grid.Column="1"
                        x:Name="PitchSlider"
                        Minimum="-6" Maximum="6"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Margin="0,4,8,0"
                        ValueChanged="OnPitchChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                        x:Name="PitchLabel"
                        Text="+0st"
                        VerticalAlignment="Center"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"/>
                <!-- Volume -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                        Text="Volume:"
                        VerticalAlignment="Center"
                        Margin="0,4,0,0"/>
                <Slider Grid.Row="3" Grid.Column="1"
                        x:Name="VolumeSlider"
                        Minimum="50" Maximum="150"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Margin="0,4,8,0"
                        ValueChanged="OnVolumeChanged"/>
                <TextBlock Grid.Row="3" Grid.Column="2"
                       x:Name="VolumeLabel"
                       Text="100%"
                       VerticalAlignment="Center"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Right"/>
            </Grid>
        </GroupBox>

        <!-- Activity log -->
        <TextBox Grid.Row="3"
                 x:Name="LogView"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 MaxHeight="80"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="10"
                 Foreground="#444444"
                 Background="#F5F5F5"
                 Margin="0,8,0,0"
                 Padding="4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <Button x:Name="PreviewBtn"
                    Content="🔍 Preview"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnPreviewClick"/>
            <Button x:Name="StopBtn"
                    Content="⏹ Stop"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="OnStopClick"/>
            <Button Content="Clear"
                    Width="60"
                    Margin="0,0,8,0"
                    Click="OnClearClick"/>
            <Button Content="Close"
                    Width="60"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick"/>
        </StackPanel>

    </Grid>
</Window>

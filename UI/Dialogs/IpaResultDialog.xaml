<Window x:Class="NarraVoice.UI.Dialogs.IpaResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NarraVoice.UI.Converters"
        Title="Smart IPA"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="IpaButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#F0F4F8"/>
            <Setter Property="BorderBrush" Value="#B0C4DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E86C1"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="16,12">

        <!-- Header -->
        <TextBlock x:Name="HeaderText"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <!-- Single result panel -->
        <StackPanel x:Name="SingleResultPanel" Visibility="Collapsed">
            <Border Background="#F0F4F8"
                    BorderBrush="#B0C4DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <TextBlock x:Name="SingleIpaText"
                           FontFamily="Consolas"
                           FontSize="16"/>
            </Border>
            <TextBlock x:Name="SingleDescText"
                       Margin="0,4,0,0"
                       Foreground="#555555"
                       FontStyle="Italic"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Insert"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="OnInsertClick"
                        IsDefault="True"/>
                <Button Content="Cancel"
                        Width="80"
                        Click="OnCancelClick"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <!-- Multiple results panel -->
        <StackPanel x:Name="MultiResultPanel" Visibility="Collapsed">
            <TextBlock Text="This word has multiple pronunciations. Select the one that fits:"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <ItemsControl x:Name="IpaOptionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource IpaButtonStyle}"
                                Tag="{Binding Ipa}"
                                Click="OnOptionClick">
                            <StackPanel>
                                <TextBlock Text="{Binding Ipa}"
                                           FontFamily="Consolas"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="#555555"
                                           Visibility="{Binding HasDescription,
                                               Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Cancel"
                    HorizontalAlignment="Right"
                    Width="80"
                    Margin="0,8,0,0"
                    Click="OnCancelClick"
                    IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>


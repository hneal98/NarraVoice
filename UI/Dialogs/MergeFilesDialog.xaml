<Window x:Class="NarraVoice.UI.Dialogs.MergeFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Audio Files" Height="450" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ChooseFolderBtn" Content="Choose Folder..." Click="OnChooseFolder" Padding="8,3"/>
            <TextBlock x:Name="FolderLabel" Margin="10,4,0,0" Foreground="Gray"/>
        </StackPanel>

        <ListBox x:Name="FileList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button x:Name="MoveUpBtn" Content="▲ Move Up" Click="OnMoveUp" Padding="8,3" Margin="0,0,5,0"/>
            <Button x:Name="MoveDownBtn" Content="▼ Move Down" Click="OnMoveDown" Padding="8,3"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" Padding="12,4" Margin="0,0,8,0"/>
            <Button x:Name="MergeBtn" Content="Merge..." Click="OnMerge" Padding="12,4"/>
        </StackPanel>
    </Grid>
</Window>
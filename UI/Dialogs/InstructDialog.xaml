<Window x:Class="NarraVoice.UI.Dialogs.InstructDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Instruction"
        Width="460" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
            Describe the delivery style in a short phrase (e.g. "speak lively and excited").
            Keep it brief and focused on tone/delivery only — long or content-like text may be spoken aloud instead of just shaping how it's read.
        </TextBlock>

        <TextBox x:Name="InstructTextBox"
                  Height="70"
                  TextWrapping="Wrap"
                  AcceptsReturn="True"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OnOkClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>